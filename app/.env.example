# Copie para .env.local. Sem estas duas linhas, a Escola roda no modo de demonstração local.
# A chave é a publicável do Supabase (sb_publishable_...), feita para ir no navegador; nunca a secreta.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Opcional: 1 mostra o campo do código de 6 dígitos no login. Só ligue depois do SMTP próprio
# no Supabase e de um modelo de e-mail com {{ .Token }} (o modelo padrão manda só o link).
VITE_LOGIN_POR_CODIGO=
